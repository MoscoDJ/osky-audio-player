{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osky Audio Player",
  "mainBinaryName": "osky-player",
  "version": "0.1.0",
  "identifier": "mx.osky.audioplayer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Osky Audio Player",
        "width": 1000,
        "height": 600,
        "minWidth": 560,
        "minHeight": 420,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Audio",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "publisher": "MoscoDJ",
    "copyright": "© 2026 MoscoDJ",
    "shortDescription": "Reproductor para clasificar tracks de DJ a toda velocidad",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["mp3"], "mimeType": "audio/mpeg", "name": "MP3", "role": "Viewer" },
      { "ext": ["flac"], "mimeType": "audio/flac", "name": "FLAC", "role": "Viewer" },
      { "ext": ["wav"], "mimeType": "audio/vnd.wave", "name": "WAV", "role": "Viewer" },
      { "ext": ["aac"], "mimeType": "audio/aac", "name": "AAC", "role": "Viewer" },
      { "ext": ["m4a"], "mimeType": "audio/mp4", "name": "M4A", "role": "Viewer" }
    ]
  }
}
